classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +Priority priority
        +str frequency
        +str preferred_time
        +bool completed
        +mark_complete() None
        +is_due_today() bool
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Scheduler {
        +Owner owner
        +generate_plan() DailyPlan
        +sort_by_priority(tasks: list~Task~) list~Task~
        +fit_to_time(tasks: list~Task~, minutes: int) list~Task~
        +detect_conflicts(plan: DailyPlan) list~str~
    }

    class DailyPlan {
        +date date
        +list~ScheduledTask~ scheduled
        +list~Task~ skipped
        +total_minutes() int
        +explain() str
    }

    class ScheduledTask {
        +Task task
        +Pet pet
        +time start_time
        +str reason
        +end_time() time
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" *-- "*" Task : needs
    Task --> Priority : has
    Scheduler --> Owner : reads pets and tasks from
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" *-- "*" ScheduledTask : contains
    ScheduledTask --> Task : schedules
    ScheduledTask --> Pet : for