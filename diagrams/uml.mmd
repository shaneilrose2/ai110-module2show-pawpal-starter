classDiagram
    %% PawPal+ design. Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~tuple~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
    }

    class Task {
        +str title
        +str category
        +int duration_minutes
        +Priority priority
        +str frequency
        +str preferred_time
        +time fixed_time
        +date last_completed
        +mark_complete(on: date) None
        +is_due(on: date) bool
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Scheduler {
        +Owner owner
        +generate_plan(on: date) DailyPlan
        +sort_by_priority(tasks: list~Task~) list~Task~
        +fit_to_time(tasks: list~Task~, minutes: int) list~Task~
        +detect_conflicts(plan: DailyPlan) list~str~
        +complete_task(pet_name: str, title: str, on: date) None
    }

    class DailyPlan {
        +date date
        +list~ScheduledTask~ scheduled
        +list~SkippedTask~ skipped
        +total_minutes() int
        +explain() str
    }

    class ScheduledTask {
        +Task task
        +Pet pet
        +time start_time
        +str reason
        +end_time() time
    }

    class SkippedTask {
        +Task task
        +Pet pet
        +str reason
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" *-- "*" Task : needs
    Task --> Priority : has
    Scheduler --> Owner : reads pets and tasks from
    Scheduler ..> DailyPlan : creates
    DailyPlan "1" *-- "*" ScheduledTask : contains
    DailyPlan "1" *-- "*" SkippedTask : contains
    ScheduledTask --> Task : schedules
    ScheduledTask --> Pet : for
    SkippedTask --> Task : skips
    SkippedTask --> Pet : for
